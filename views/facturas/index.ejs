<script type="application/json" id="datos-pagina"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>

<div x-data="facturas" @keydown.escape.window="cancelarPago()">

  <!-- ===== Filtros ===== -->
  <section class="rounded-md border border-borde bg-white p-4" aria-label="Filtros">
    <div class="flex flex-wrap items-end gap-x-4 gap-y-3">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Rangos rápidos">
        <template x-for="p in presets" :key="p.etiqueta">
          <button type="button" @click="aplicarPreset(p)" :aria-pressed="presetActivo(p)"
                  class="h-11 rounded-full border px-4 text-sm font-medium"
                  :class="presetActivo(p) ? 'border-primario bg-primario text-white' : 'border-borde bg-white hover:bg-fondo'" x-text="p.etiqueta"></button>
        </template>
      </div>

      <div class="flex items-end gap-2">
        <div>
          <label class="etiqueta text-xs" for="f-desde">Desde</label>
          <input id="f-desde" type="date" class="campo h-11 w-[9.5rem] py-1.5" x-model="f.desde" :max="f.hasta || null">
        </div>
        <div>
          <label class="etiqueta text-xs" for="f-hasta">Hasta</label>
          <input id="f-hasta" type="date" class="campo h-11 w-[9.5rem] py-1.5" x-model="f.hasta" :min="f.desde || null">
        </div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto]">
      <div class="relative">
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" x-model="f.q" placeholder="Buscar por cliente o número de factura" aria-label="Buscar por cliente o número de factura" class="campo h-11 pl-9" autocomplete="off">
      </div>
      <select x-model="f.tipo" class="campo h-11 sm:w-auto" aria-label="Tipo de documento">
        <option value="">Fiscales e internas</option>
        <option value="fiscal">Solo fiscales</option>
        <option value="interno">Solo internas</option>
      </select>
      <select x-model="f.estado" class="campo h-11 sm:w-auto" aria-label="Estado de pago">
        <option value="">Pagadas y pendientes</option>
        <option value="P">Solo pendientes</option>
        <option value="C">Solo pagadas</option>
      </select>
    </div>

    <p class="mt-3 text-sm text-red-700" x-show="error" x-cloak role="alert" x-text="error"></p>
  </section>

  <!-- ===== Resumen ===== -->
  <div class="mt-4 flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm" aria-live="polite">
    <p>
      <span class="font-titulo text-2xl font-semibold tabular-nums" x-text="resumen.cantidad"></span>
      <span class="text-gray-600" x-text="resumen.cantidad === 1 ? 'documento' : 'documentos'"></span>
    </p>
    <p><span class="text-gray-600">Total: </span><span class="font-medium tabular-nums" x-text="dinero(resumen.suma)"></span></p>
    <p x-show="resumen.pendiente > 0" x-cloak><span class="text-gray-600">Pendiente de cobro: </span><span class="font-medium tabular-nums text-amber-700" x-text="dinero(resumen.pendiente)"></span></p>
    <p class="text-gray-500" x-show="cargando" x-cloak>Actualizando…</p>
  </div>

  <!-- ===== Sin resultados ===== -->
  <div x-show="filas.length === 0 && !cargando" x-cloak class="mt-4 rounded-md border border-borde bg-white px-6 py-14 text-center">
    <p class="font-titulo text-xl font-semibold">No hay facturas con estos filtros</p>
    <p class="mt-1 text-sm text-gray-600">Cambia las fechas o quita algún filtro.</p>
    <button type="button" class="btn btn-secundario mt-4" x-show="hayFiltros" @click="limpiar()">Quitar filtros</button>
    <a href="/pos" class="btn btn-primario mt-4" x-show="!hayFiltros && f.desde === '' && f.hasta === ''">Ir al punto de venta</a>
  </div>

  <!-- ===== Tabla (pantallas medianas y grandes) ===== -->
  <div class="mt-4 hidden overflow-x-auto rounded-md border border-borde bg-white md:block" x-show="filas.length > 0" x-cloak>
    <table class="min-w-full text-sm">
      <thead class="border-b border-borde bg-fondo text-left text-xs font-semibold text-gray-600">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">Número</th>
          <th scope="col" class="px-4 py-3 font-semibold">Fecha</th>
          <th scope="col" class="px-4 py-3 font-semibold">Cliente</th>
          <th scope="col" class="px-4 py-3 font-semibold">Tipo</th>
          <th scope="col" class="px-4 py-3 font-semibold">Pago</th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">Total</th>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-borde">
        <template x-for="fila in filas" :key="fila.id">
          <tr class="hover:bg-fondo/60">
            <td class="whitespace-nowrap px-4 py-3 font-medium tabular-nums" :title="fila.numero_factura" x-text="fila.numero_corto"></td>
            <td class="whitespace-nowrap px-4 py-3 text-gray-600 tabular-nums" x-text="fila.fecha_texto"></td>
            <td class="max-w-[14rem] truncate px-4 py-3" :class="fila.cliente === 'Consumidor Final' ? 'text-gray-500' : ''" x-text="fila.cliente"></td>
            <td class="px-4 py-3"><span class="insignia" :class="fila.tipo_documento === 'fiscal' ? 'ins-marca' : 'ins-neutra'" x-text="fila.tipo_documento === 'fiscal' ? 'Fiscal' : 'Interna'"></span></td>
            <td class="px-4 py-3"><span class="insignia" :class="fila.estado === 'C' ? 'ins-ok' : 'ins-bajo'"><i></i><span x-text="fila.estado === 'C' ? 'Pagada' : 'Pendiente'"></span></span></td>
            <td class="whitespace-nowrap px-4 py-3 text-right font-medium tabular-nums" x-text="dinero(fila.total)"></td>
            <td class="whitespace-nowrap px-4 py-3 text-right">
              <a :href="'/facturas/' + fila.id + '/pdf'" target="_blank" rel="noopener" class="btn-texto">Ver PDF</a>
              <a :href="'/facturas/' + fila.id + '/pdf?descargar=1'" class="btn-texto apagar">Descargar</a>
              <button type="button" class="btn-texto" x-show="fila.estado === 'P'" @click="pedirPago(fila)">Marcar pagada</button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <!-- ===== Tarjetas (celular) ===== -->
  <div class="mt-4 space-y-3 md:hidden" x-show="filas.length > 0" x-cloak>
    <template x-for="fila in filas" :key="fila.id">
      <article class="rounded-md border border-borde bg-white p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium tabular-nums" x-text="fila.numero_corto"></p>
            <p class="text-xs text-gray-500 tabular-nums" x-text="fila.fecha_texto"></p>
          </div>
          <p class="flex-none font-titulo text-xl font-semibold tabular-nums" x-text="dinero(fila.total)"></p>
        </div>
        <p class="mt-2 truncate text-sm" :class="fila.cliente === 'Consumidor Final' ? 'text-gray-500' : ''" x-text="fila.cliente"></p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <span class="insignia" :class="fila.tipo_documento === 'fiscal' ? 'ins-marca' : 'ins-neutra'" x-text="fila.tipo_documento === 'fiscal' ? 'Fiscal' : 'Interna'"></span>
          <span class="insignia" :class="fila.estado === 'C' ? 'ins-ok' : 'ins-bajo'"><i></i><span x-text="fila.estado === 'C' ? 'Pagada' : 'Pendiente'"></span></span>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-borde pt-3">
          <a :href="'/facturas/' + fila.id + '/pdf'" target="_blank" rel="noopener" class="btn btn-secundario h-11 flex-1">Ver PDF</a>
          <a :href="'/facturas/' + fila.id + '/pdf?descargar=1'" class="btn btn-secundario h-11 flex-1">Descargar</a>
          <button type="button" class="btn btn-primario h-11 w-full" x-show="fila.estado === 'P'" @click="pedirPago(fila)">Marcar como pagada</button>
        </div>
      </article>
    </template>
  </div>

  <div class="mt-4 text-center" x-show="hayMas" x-cloak>
    <button type="button" class="btn btn-secundario" :disabled="cargando" @click="cargar(false)" x-text="cargando ? 'Cargando…' : 'Cargar más'"></button>
  </div>

  <!-- ===== Confirmar pago ===== -->
  <div x-show="confirmar" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-label="Marcar factura como pagada">
    <div class="absolute inset-0 bg-tinta/50" x-show="confirmar"
         x-transition:enter="transition-opacity duration-150" x-transition:enter-start="opacity-0"
         x-transition:leave="transition-opacity duration-100" x-transition:leave-end="opacity-0"
         @click="cancelarPago()"></div>
    <div x-show="confirmar" class="relative w-full max-w-sm rounded-t-2xl bg-white p-5 shadow-xl sm:rounded-lg"
         x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="translate-y-6 opacity-0 sm:translate-y-2 sm:scale-95"
         x-transition:leave="transition duration-100 ease-in" x-transition:leave-end="translate-y-4 opacity-0 sm:scale-95">
      <template x-if="confirmar">
        <div>
          <h2 class="font-titulo text-xl font-semibold">¿Marcar como pagada?</h2>
          <p class="mt-2 text-sm text-gray-600">
            La factura <span class="font-medium text-tinta tabular-nums" x-text="confirmar.numero_corto"></span> de
            <span class="font-medium text-tinta" x-text="confirmar.cliente"></span> por
            <span class="font-medium text-tinta tabular-nums" x-text="dinero(confirmar.total)"></span> quedará como pagada. Esto no se puede deshacer desde aquí.
          </p>
          <div class="mt-5 flex gap-2" style="padding-bottom: env(safe-area-inset-bottom, 0px)">
            <button type="button" class="btn btn-secundario flex-1" @click="cancelarPago()" :disabled="pagando">Cancelar</button>
            <button type="button" class="btn btn-primario flex-1" @click="confirmarPago()" :disabled="pagando" x-text="pagando ? 'Guardando…' : 'Sí, marcar pagada'"></button>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>

<script src="/js/facturas.js"></script>
