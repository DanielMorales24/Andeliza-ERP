<main class="flex min-h-screen items-center justify-center px-6 py-12">
  <form method="post" action="/cambiar-contrasena" class="w-full max-w-sm" x-data="{ ver: false }">
    <h1 class="font-titulo text-3xl font-semibold">Cambiar contraseña</h1>
    <% if (obligatorio) { %>
      <p class="mt-2 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">Tu contraseña es provisional. Elige una nueva para continuar.</p>
    <% } %>
    <% if (error) { %>
      <div role="alert" class="mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= error %></div>
    <% } %>

    <label for="actual" class="mt-6 block text-sm font-medium">Contraseña actual</label>
    <input id="actual" name="actual" :type="ver ? 'text' : 'password'" required autofocus autocomplete="current-password"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">

    <label for="nueva" class="mt-4 block text-sm font-medium">Contraseña nueva</label>
    <input id="nueva" name="nueva" :type="ver ? 'text' : 'password'" required minlength="8" maxlength="72" autocomplete="new-password"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">
    <p class="mt-1 text-xs text-gray-500">Mínimo 8 caracteres, con letras y números.</p>

    <label for="confirmar" class="mt-4 block text-sm font-medium">Repite la contraseña nueva</label>
    <input id="confirmar" name="confirmar" :type="ver ? 'text' : 'password'" required autocomplete="new-password"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">

    <label class="mt-3 flex items-center gap-2 text-sm text-gray-600"><input type="checkbox" x-model="ver"> Mostrar contraseñas</label>

    <button type="submit" class="mt-6 w-full rounded bg-primario px-4 py-2.5 font-semibold text-white hover:brightness-110">Guardar contraseña</button>
    <% if (obligatorio) { %>
      <button type="submit" formaction="/logout" formnovalidate class="mt-3 w-full rounded border border-borde px-4 py-2.5 text-sm font-medium hover:bg-fondo">Salir</button>
    <% } else { %>
      <a href="/" class="mt-3 block text-center text-sm text-gray-600 hover:underline">Cancelar</a>
    <% } %>
  </form>
</main>
