<main class="flex min-h-screen items-center justify-center px-6 py-12">
  <form method="post" action="/cambiar-contrasena" class="w-full max-w-sm" x-data="claveSegura()" data-usuario="<%= usuarioActual.usuario %>" x-init="usuario = $el.dataset.usuario">
    <h1 class="font-titulo text-3xl font-semibold">Cambiar contraseña</h1>
    <% if (obligatorio) { %>
      <p class="mt-2 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">Tu contraseña es provisional. Elige una nueva para continuar.</p>
    <% } %>
    <% if (error) { %>
      <div role="alert" class="mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= error %></div>
    <% } %>

    <label for="actual" class="etiqueta mt-6">Contraseña actual</label>
    <input id="actual" name="actual" class="campo" :type="ver ? 'text' : 'password'" required autofocus autocomplete="current-password">

    <%- include('../partials/clave', { campo: { id: 'nueva', nombre: 'nueva', nombreConfirmar: 'confirmar', etiqueta: 'Contraseña nueva', etiquetaConfirmar: 'Repite la contraseña nueva' } }) %>

    <button type="submit" data-guardar class="btn btn-primario mt-6 h-11 w-full" :disabled="!valida">Guardar contraseña</button>
    <% if (obligatorio) { %>
      <button type="submit" formaction="/logout" formnovalidate class="mt-3 w-full rounded border border-borde px-4 py-2.5 text-sm font-medium hover:bg-fondo">Salir</button>
    <% } else { %>
      <a href="/" class="mt-3 block text-center text-sm text-gray-600 hover:underline">Cancelar</a>
    <% } %>
  </form>
</main>
<script src="/js/contrasena.js"></script>
