<main class="flex min-h-screen items-center justify-center px-6 py-12">
  <form method="post" action="/recuperar" class="w-full max-w-sm" x-data="{ ver: false }">
    <h1 class="font-titulo text-3xl font-semibold">Recuperar contraseña</h1>
    <p class="mt-2 text-sm text-gray-600">Pide al administrador un código de recuperación. Dura 30 minutos y se usa una sola vez.</p>
    <% if (error) { %>
      <div role="alert" class="mt-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= error %></div>
    <% } %>

    <label for="usuario" class="mt-6 block text-sm font-medium">Usuario</label>
    <input id="usuario" name="usuario" type="text" value="<%= usuario %>" required autofocus autocomplete="username" autocapitalize="none" spellcheck="false"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">

    <label for="codigo" class="mt-4 block text-sm font-medium">Código de recuperación</label>
    <input id="codigo" name="codigo" type="text" value="<%= codigo %>" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX" maxlength="12"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 font-mono tracking-widest uppercase focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">

    <label for="nueva" class="mt-4 block text-sm font-medium">Contraseña nueva</label>
    <input id="nueva" name="nueva" :type="ver ? 'text' : 'password'" required minlength="8" maxlength="72" autocomplete="new-password"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">
    <p class="mt-1 text-xs text-gray-500">Mínimo 8 caracteres, con letras y números.</p>

    <label for="confirmar" class="mt-4 block text-sm font-medium">Repite la contraseña nueva</label>
    <input id="confirmar" name="confirmar" :type="ver ? 'text' : 'password'" required autocomplete="new-password"
           class="mt-1 w-full rounded border border-borde bg-white px-3 py-2.5 focus:border-primario focus:outline-none focus:ring-2 focus:ring-primario/30">

    <label class="mt-3 flex items-center gap-2 text-sm text-gray-600"><input type="checkbox" x-model="ver"> Mostrar contraseñas</label>

    <button type="submit" class="mt-6 w-full rounded bg-primario px-4 py-2.5 font-semibold text-white hover:brightness-110">Cambiar contraseña</button>
    <a href="/login" class="mt-3 block text-center text-sm text-gray-600 hover:underline">Volver a iniciar sesión</a>
  </form>
</main>
