<script type="application/json" id="datos-pagina"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>

<form x-data="formProducto" @submit.prevent="guardar()" novalidate class="pb-24 lg:pb-0">

  <a href="/inventario" class="inline-flex items-center gap-1 text-sm text-gray-600 hover:text-primario">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
    Volver al inventario
  </a>

  <div id="resumen-errores" x-show="errores.length > 0" x-cloak role="alert" class="mt-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
    <p class="font-medium" x-text="errores.length === 1 ? 'Revisa esto antes de guardar:' : 'Revisa estos puntos antes de guardar:'"></p>
    <ul class="mt-1 list-disc pl-5"><template x-for="e in errores" :key="e"><li x-text="e"></li></template></ul>
  </div>

  <div class="mt-4 grid gap-6 lg:grid-cols-3">

    <!-- ============ Columna principal ============ -->
    <div class="space-y-6 lg:col-span-2">

      <!-- Datos generales -->
      <section class="rounded-md border border-borde bg-white p-5">
        <h2 class="font-titulo text-lg font-semibold">Datos generales</h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="etiqueta" for="p-nombre">Nombre <span class="text-red-600" aria-hidden="true">*</span></label>
            <input id="p-nombre" class="campo" x-model="f.nombre" maxlength="200" required autocomplete="off" placeholder="Ej. Camiseta Real Madrid">
          </div>

          <div>
            <label class="etiqueta" for="p-sku">SKU</label>
            <input id="p-sku" class="campo" x-model="f.sku" maxlength="50" autocomplete="off" placeholder="Código interno (opcional)">
          </div>
          <div>
            <label class="etiqueta" for="p-unidad">Unidad de venta</label>
            <select id="p-unidad" class="campo" x-model="f.unidad">
              <template x-for="u in d.unidades" :key="u"><option :value="u" x-text="u"></option></template>
            </select>
          </div>

          <div>
            <label class="etiqueta" for="p-categoria">Categoría</label>
            <select id="p-categoria" class="campo" x-model="f.categoria_id">
              <option value="">Sin categoría</option>
              <template x-for="c in d.categorias" :key="c.id"><option :value="c.id" x-text="c.nombre"></option></template>
            </select>
            <p class="ayuda"><a href="/categorias" class="text-primario hover:underline">Administrar categorías</a></p>
          </div>
          <div>
            <label class="etiqueta" for="p-proveedor">Proveedor</label>
            <select id="p-proveedor" class="campo" x-model="f.proveedor_id">
              <option value="">Sin proveedor</option>
              <template x-for="p in d.proveedores" :key="p.id"><option :value="p.id" x-text="p.nombre"></option></template>
            </select>
          </div>

          <div>
            <label class="etiqueta" for="p-compra">Precio de compra</label>
            <input id="p-compra" class="campo" type="number" inputmode="decimal" min="0" step="any" x-model="f.precio_compra">
          </div>
          <div>
            <label class="etiqueta" for="p-venta">Precio de venta</label>
            <input id="p-venta" class="campo" type="number" inputmode="decimal" min="0" step="any" x-model="f.precio_venta">
          </div>
          <p class="ayuda -mt-2 sm:col-span-2" x-show="margen !== null" x-cloak>
            Ganancia por unidad: <span class="font-medium" :class="ganancia < 0 ? 'text-red-700' : 'text-gray-800'" x-text="dinero(ganancia)"></span>
            (margen <span x-text="margen + '%'"></span>)
          </p>

          <div x-show="!conVariantes && !esKit">
            <label class="etiqueta" for="p-stock">Stock actual</label>
            <input id="p-stock" class="campo" type="number" inputmode="decimal" min="0" step="any" x-model="f.stock">
          </div>
          <div x-show="!conVariantes && !esKit">
            <label class="etiqueta" for="p-minimo">Stock mínimo</label>
            <input id="p-minimo" class="campo" type="number" inputmode="decimal" min="0" step="any" x-model="f.stock_minimo">
            <p class="ayuda">Avisa cuando el stock llegue a este número.</p>
          </div>

          <div class="rounded bg-fondo px-3 py-2.5 text-sm text-gray-700 sm:col-span-2" x-show="conVariantes" x-cloak>
            El stock se maneja por variante. Total ahora: <span class="font-medium" x-text="cantidad(stockTotalVariantes)"></span>.
            <span class="text-amber-700" x-show="Number(f.stock) > 0">El stock que tiene el producto (<span x-text="cantidad(f.stock)"></span>) ya no se usará: repártelo entre las variantes.</span>
          </div>
          <div class="rounded bg-fondo px-3 py-2.5 text-sm text-gray-700 sm:col-span-2" x-show="esKit" x-cloak>
            El stock de un kit se calcula con sus componentes. Con lo que hay ahora alcanza para
            <span class="font-medium" x-text="kitsPosibles"></span> kits.
          </div>

          <div class="sm:col-span-2">
            <label class="etiqueta" for="p-descripcion">Descripción</label>
            <textarea id="p-descripcion" class="campo" rows="3" maxlength="2000" x-model="f.descripcion"></textarea>
          </div>
        </div>
      </section>

      <% if (datos.funcionalidades.variantes) { %>
      <!-- Variantes -->
      <section class="rounded-md border border-borde bg-white">
        <header class="flex items-start justify-between gap-4 px-5 py-4">
          <div>
            <h2 class="font-titulo text-lg font-semibold">Variantes</h2>
            <p class="text-sm text-gray-600">Tallas, equipos u otras opciones, cada una con su propio stock.</p>
          </div>
          <label class="flex flex-none items-center">
            <span class="sr-only">Este producto tiene variantes</span>
            <input type="checkbox" class="interruptor" x-model="conVariantes" @change="alCambiarVariantes()" :disabled="esKit">
          </label>
        </header>
        <p class="px-5 pb-4 text-sm text-gray-500" x-show="esKit" x-cloak>Un kit no puede tener variantes.</p>

        <div x-show="conVariantes" x-cloak class="border-t border-borde px-5 py-5">

          <!-- Generador de combinaciones -->
          <div class="rounded-md border border-borde bg-fondo/60 p-4" x-show="hayOpciones">
            <p class="text-sm font-medium">Generar combinaciones</p>
            <p class="ayuda">Elige las opciones y se crean todas las combinaciones de una vez.</p>

            <template x-for="tipo in d.tiposVariante" :key="tipo">
              <div class="mt-3" x-show="opciones(tipo).length > 0">
                <p class="text-xs font-medium text-gray-600" x-text="mayus(tipo) + 's'"></p>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  <template x-for="op in opciones(tipo)" :key="op">
                    <button type="button" @click="alternarOpcion(tipo, op)" :aria-pressed="generador.seleccion[tipo].includes(op)"
                            class="rounded-full border px-3 py-1 text-sm transition-colors"
                            :class="generador.seleccion[tipo].includes(op) ? 'border-primario bg-primario text-white' : 'border-borde bg-white hover:bg-fondo'" x-text="op"></button>
                  </template>
                </div>
              </div>
            </template>

            <div class="mt-4 flex flex-wrap items-end gap-3">
              <div>
                <label class="etiqueta text-xs" for="gen-minimo">Stock mínimo de cada una</label>
                <input id="gen-minimo" type="number" min="0" step="any" class="campo w-28 py-1.5" x-model="generador.stockMinimo">
              </div>
              <button type="button" class="btn btn-secundario" :disabled="combinacionesNuevas.length === 0" @click="agregarCombinaciones()">
                <span x-text="combinacionesNuevas.length > 0 ? 'Agregar ' + combinacionesNuevas.length + (combinacionesNuevas.length === 1 ? ' variante' : ' variantes') : 'Agregar combinaciones'"></span>
              </button>
            </div>
          </div>

          <!-- Lista de variantes -->
          <div class="mt-4 overflow-x-auto rounded-md border border-borde" x-show="variantes.length > 0">
            <table class="min-w-full text-sm">
              <thead class="border-b border-borde bg-fondo text-left text-xs font-semibold text-gray-600">
                <tr>
                  <template x-for="tipo in d.tiposVariante" :key="tipo"><th scope="col" class="px-3 py-2 font-semibold" x-text="mayus(tipo)"></th></template>
                  <th scope="col" class="px-3 py-2 font-semibold">SKU</th>
                  <th scope="col" class="px-3 py-2 text-right font-semibold">Stock</th>
                  <th scope="col" class="px-3 py-2 text-right font-semibold">Mínimo</th>
                  <th scope="col" class="px-3 py-2"><span class="sr-only">Quitar</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-borde">
                <template x-for="(v, i) in variantes" :key="v.uid">
                  <tr>
                    <template x-for="tipo in d.tiposVariante" :key="tipo">
                      <td class="px-3 py-1.5"><input class="campo w-28 py-1.5" :list="'opciones-' + tipo" x-model="v.atributos[tipo]" :aria-label="mayus(tipo) + ' de la variante ' + (i + 1)" maxlength="40" autocomplete="off"></td>
                    </template>
                    <td class="px-3 py-1.5"><input class="campo w-36 py-1.5" x-model="v.sku" :placeholder="skuAuto(v) || 'Automático'" maxlength="50" aria-label="SKU de la variante" autocomplete="off"></td>
                    <td class="px-3 py-1.5"><input class="campo w-24 py-1.5 text-right" type="number" inputmode="decimal" min="0" step="any" x-model="v.stock" aria-label="Stock de la variante"></td>
                    <td class="px-3 py-1.5"><input class="campo w-20 py-1.5 text-right" type="number" inputmode="decimal" min="0" step="any" x-model="v.stock_minimo" aria-label="Stock mínimo de la variante"></td>
                    <td class="px-3 py-1.5 text-right">
                      <button type="button" class="btn-texto peligro" @click="quitarVariante(i)" aria-label="Quitar variante">Quitar</button>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <template x-for="tipo in d.tiposVariante" :key="'dl-' + tipo">
            <datalist :id="'opciones-' + tipo"><template x-for="op in opciones(tipo)" :key="op"><option :value="op"></option></template></datalist>
          </template>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
            <button type="button" class="btn-texto" @click="agregarVariante()">+ Agregar una variante</button>
            <p class="text-sm text-gray-600" x-show="variantes.length > 0">
              <span x-text="variantes.length"></span> <span x-text="variantes.length === 1 ? 'variante' : 'variantes'"></span>,
              <span class="font-medium" x-text="cantidad(stockTotalVariantes)"></span> en total
            </p>
          </div>
        </div>
      </section>
      <% } %>

      <% if (datos.funcionalidades.kits) { %>
      <!-- Kit -->
      <section class="rounded-md border border-borde bg-white">
        <header class="flex items-start justify-between gap-4 px-5 py-4">
          <div>
            <h2 class="font-titulo text-lg font-semibold">Kit (producto compuesto)</h2>
            <p class="text-sm text-gray-600">Se vende como un solo producto y descuenta el stock de sus componentes.</p>
          </div>
          <label class="flex flex-none items-center">
            <span class="sr-only">Este producto es un kit</span>
            <input type="checkbox" class="interruptor" x-model="esKit" @change="alCambiarKit()" :disabled="conVariantes">
          </label>
        </header>
        <p class="px-5 pb-4 text-sm text-gray-500" x-show="conVariantes" x-cloak>Un producto con variantes no puede ser un kit.</p>

        <div x-show="esKit" x-cloak class="border-t border-borde px-5 py-5">
          <label class="etiqueta" for="kit-buscar">Agregar un componente</label>
          <div class="relative" @click.outside="listaKit = false">
            <input id="kit-buscar" class="campo" x-model="busquedaKit" @focus="listaKit = true" @input="listaKit = true" @keydown.escape.stop="listaKit = false"
                   placeholder="Busca por nombre o SKU" autocomplete="off" role="combobox" :aria-expanded="listaKit && resultadosKit.length > 0">
            <ul x-show="listaKit && resultadosKit.length > 0" x-cloak role="listbox"
                class="absolute z-20 mt-1 max-h-64 w-full overflow-auto rounded-md border border-borde bg-white py-1 shadow-lg">
              <template x-for="p in resultadosKit" :key="p.id">
                <li role="option">
                  <button type="button" @click="agregarComponente(p)" class="flex w-full items-center justify-between gap-3 px-3 py-2 text-left text-sm hover:bg-fondo">
                    <span class="truncate" x-text="p.nombre"></span>
                    <span class="flex-none text-xs text-gray-500" x-text="(p.sku || 'Sin SKU') + ' · ' + cantidad(p.stock) + ' en stock'"></span>
                  </button>
                </li>
              </template>
            </ul>
          </div>
          <p class="ayuda" x-show="d.candidatosKit.length === 0">No hay productos para usar como componentes. Crea primero los productos simples (sin variantes).</p>
          <p class="ayuda" x-show="d.candidatosKit.length > 0">Solo aparecen productos simples: un componente no puede tener variantes ni ser otro kit.</p>

          <div class="mt-4 overflow-x-auto rounded-md border border-borde" x-show="componentes.length > 0">
            <table class="min-w-full text-sm">
              <thead class="border-b border-borde bg-fondo text-left text-xs font-semibold text-gray-600">
                <tr>
                  <th scope="col" class="px-3 py-2 font-semibold">Componente</th>
                  <th scope="col" class="px-3 py-2 text-right font-semibold">Cantidad</th>
                  <th scope="col" class="px-3 py-2 text-right font-semibold">En stock</th>
                  <th scope="col" class="px-3 py-2"><span class="sr-only">Quitar</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-borde">
                <template x-for="(c, i) in componentes" :key="c.producto_id">
                  <tr>
                    <td class="px-3 py-2"><span class="font-medium" x-text="c.nombre"></span><span class="block text-xs text-gray-500" x-text="c.sku || 'Sin SKU'"></span></td>
                    <td class="px-3 py-1.5 text-right">
                      <input class="campo w-24 py-1.5 text-right" type="number" inputmode="decimal" min="0.01" step="any" x-model="c.cantidad" :aria-label="'Cantidad de ' + c.nombre">
                    </td>
                    <td class="px-3 py-2 text-right tabular-nums text-gray-600"><span x-text="cantidad(c.stock)"></span> <span class="text-xs" x-text="c.unidad"></span></td>
                    <td class="px-3 py-1.5 text-right"><button type="button" class="btn-texto peligro" @click="quitarComponente(i)">Quitar</button></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm" x-show="componentes.length > 0">
            <p class="text-gray-600">Costo de los componentes: <span class="font-medium text-gray-900" x-text="dinero(costoComponentes)"></span></p>
            <button type="button" class="btn-texto" @click="usarCostoComponentes()">Usar como precio de compra</button>
          </div>
        </div>
      </section>
      <% } %>
    </div>

    <!-- ============ Columna lateral ============ -->
    <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">

      <section class="rounded-md border border-borde bg-white p-5">
        <h2 class="font-titulo text-lg font-semibold">Imagen</h2>
        <div class="mt-3 flex aspect-square items-center justify-center overflow-hidden rounded-md border border-dashed border-borde bg-fondo">
          <img x-show="imagen.vista" :src="imagen.vista" alt="Vista previa de la imagen del producto" class="h-full w-full object-cover">
          <p x-show="!imagen.vista" class="px-6 text-center text-sm text-gray-500">Todavía no tiene imagen</p>
        </div>
        <input id="archivo-imagen" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" @change="elegirImagen($event)">
        <div class="mt-3 flex gap-2">
          <label for="archivo-imagen" class="btn btn-secundario flex-1 cursor-pointer" x-text="imagen.vista ? 'Cambiar imagen' : 'Subir imagen'"></label>
          <button type="button" class="btn btn-secundario" x-show="imagen.vista" x-cloak @click="quitarImagen()">Quitar</button>
        </div>
        <p class="ayuda" x-text="imagen.info || 'JPG, PNG o WebP. Se reduce sola antes de subirla.'"></p>
      </section>

      <% if (datos.id) { %>
      <section class="rounded-md border border-borde bg-white p-5">
        <label class="flex cursor-pointer items-start gap-3">
          <input type="checkbox" class="interruptor mt-0.5" x-model="f.activo">
          <span>
            <span class="block text-sm font-medium">Producto activo</span>
            <span class="ayuda block">Los productos inactivos no se pueden vender.</span>
          </span>
        </label>
      </section>
      <% } %>

      <div class="hidden space-y-2 lg:block">
        <button type="submit" class="btn btn-primario w-full" :disabled="guardando" x-text="guardando ? 'Guardando…' : (d.id ? 'Guardar cambios' : 'Crear producto')"></button>
        <a href="/inventario" class="btn btn-secundario w-full">Cancelar</a>
      </div>
    </aside>
  </div>

  <!-- Barra de guardado en el celular -->
  <div class="fixed inset-x-0 bottom-0 z-30 flex gap-2 border-t border-borde bg-white p-3 lg:hidden">
    <a href="/inventario" class="btn btn-secundario flex-1">Cancelar</a>
    <button type="submit" class="btn btn-primario flex-[2]" :disabled="guardando" x-text="guardando ? 'Guardando…' : (d.id ? 'Guardar cambios' : 'Crear producto')"></button>
  </div>
</form>

<script src="/js/producto-form.js"></script>
