<%
  // Ícono según el rol (los roles que crea el administrador usan el ícono de persona)
  const iconoRol = { admin: 'shield', supervisor: 'badge', vendedor: 'bag', contador: 'calculator' }[usuarioActual.rol] || 'user';
  const inicial = (String(usuarioActual.nombre).trim().charAt(0) || '?').toUpperCase();
%>
<header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-borde bg-white px-4 sm:px-6">
  <button type="button" @click="menu = true" class="-ml-2 rounded p-2 hover:bg-fondo lg:hidden" aria-label="Abrir menú">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>

  <h1 class="font-titulo text-xl font-semibold"><%= titulo %></h1>

  <!-- Menú de perfil: lista flotante en pantallas grandes y hoja inferior en el celular -->
  <div class="relative ml-auto" x-data="{ abierto: false }" @keydown.escape.window="abierto = false">
    <button type="button" id="btn-perfil" @click="abierto = !abierto" :aria-expanded="abierto" aria-haspopup="menu" aria-controls="menu-perfil" aria-label="Menú de perfil"
            class="flex items-center gap-2 rounded-full p-1 pr-1 hover:bg-fondo focus:outline-none focus-visible:ring-2 focus-visible:ring-primario/50 md:pr-3">
      <span class="relative inline-flex h-9 w-9 items-center justify-center rounded-full bg-primario font-titulo text-lg font-semibold leading-none text-white">
        <span aria-hidden="true"><%= inicial %></span>
        <span class="absolute -bottom-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-primario ring-1 ring-borde" title="<%= usuarioActual.rol %>"><%- icono(iconoRol, 'h-2.5 w-2.5') %></span>
      </span>
      <span class="hidden max-w-[10rem] truncate text-sm font-medium md:inline"><%= usuarioActual.nombre %></span>
      <span class="hidden text-gray-500 transition-transform md:inline" :class="abierto ? 'rotate-180' : ''"><%- icono('chevron', 'h-4 w-4') %></span>
    </button>

    <!-- Al hacer clic fuera se cierra: en el celular además oscurece el fondo -->
    <div x-show="abierto" x-cloak @click="abierto = false" class="fixed inset-0 z-40 bg-black/40 sm:bg-transparent" aria-hidden="true"></div>

    <div x-show="abierto" x-cloak id="menu-perfil" role="menu" aria-label="Perfil de <%= usuarioActual.nombre %>"
         class="fixed inset-x-0 bottom-0 z-50 max-h-[85vh] overflow-y-auto rounded-t-2xl bg-white pb-6 shadow-2xl sm:absolute sm:inset-x-auto sm:bottom-auto sm:right-0 sm:top-full sm:mt-2 sm:w-72 sm:rounded-xl sm:border sm:border-borde sm:pb-0 sm:shadow-lg">
      <div class="mx-auto mt-2 h-1 w-10 rounded-full bg-gray-300 sm:hidden" aria-hidden="true"></div>
      <div class="px-4 py-4">
        <p class="truncate font-semibold"><%= usuarioActual.nombre %></p>
        <p class="truncate text-sm text-gray-500">@<%= usuarioActual.usuario %></p>
        <p class="mt-2 flex items-center gap-2 text-sm">
          <span class="inline-flex items-center gap-1 rounded bg-fondo px-2 py-0.5 text-xs font-medium text-gray-700"><%- icono(iconoRol, 'h-3.5 w-3.5') %><%= usuarioActual.rol %></span>
        </p>
        <p class="mt-2 text-xs text-gray-500">Último acceso: <%= usuarioActual.ultimoAcceso ? fechaHora(usuarioActual.ultimoAcceso) : 'primer acceso' %></p>
      </div>
      <div class="border-t border-borde py-1">
        <a href="/perfil" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-fondo"><span class="text-gray-500"><%- icono('id', 'h-4 w-4') %></span>Mi Perfil</a>
        <a href="/cambiar-contrasena" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-fondo"><span class="text-gray-500"><%- icono('key', 'h-4 w-4') %></span>Cambiar contraseña</a>
        <a href="/perfil/actividad" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-fondo"><span class="text-gray-500"><%- icono('clock', 'h-4 w-4') %></span>Mi actividad</a>
        <% if (usuarioActual.esAdmin) { %>
          <a href="/configuracion" role="menuitem" class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-fondo"><span class="text-gray-500"><%- icono('cog', 'h-4 w-4') %></span>Ir a Configuración</a>
        <% } %>
      </div>
      <div class="border-t border-borde py-1">
        <form method="post" action="/logout">
          <button type="submit" role="menuitem" class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm font-medium text-red-600 hover:bg-red-50"><%- icono('logout', 'h-4 w-4') %>Cerrar sesión</button>
        </form>
      </div>
    </div>
  </div>
</header>
