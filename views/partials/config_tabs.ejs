<%
  const pestanasConfig = [
    { clave: 'negocio', ruta: '/configuracion', nombre: 'Negocio' },
    { clave: 'usuarios', ruta: '/configuracion/usuarios', nombre: 'Usuarios' },
    { clave: 'roles', ruta: '/configuracion/roles', nombre: 'Roles y permisos' },
    { clave: 'auditoria', ruta: '/configuracion/auditoria', nombre: 'Auditoría' },
  ];
%>
<nav aria-label="Secciones de configuración" class="-mx-4 mb-5 overflow-x-auto border-b border-borde px-4 sm:-mx-6 sm:px-6">
  <ul class="flex min-w-max gap-1">
    <% pestanasConfig.forEach(function (p) { const activa = p.clave === seccion; %>
      <li>
        <a href="<%= p.ruta %>" <% if (activa) { %>aria-current="page"<% } %>
           class="-mb-px block border-b-2 px-4 py-3 text-sm font-medium whitespace-nowrap <%= activa ? 'border-primario text-primario' : 'border-transparent text-gray-600 hover:border-borde hover:text-tinta' %>"><%= p.nombre %></a>
      </li>
    <% }) %>
  </ul>
</nav>
