<% const items = modulosVisibles(usuarioActual); %>

<div x-show="menu" x-cloak @click="menu = false" class="fixed inset-0 z-30 bg-black/40 lg:hidden"></div>

<aside :class="menu ? 'translate-x-0' : '-translate-x-full'"
       class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-primario text-white transition-transform duration-200 lg:translate-x-0">
  <a href="<%= rutaInicial(usuarioActual) || '/' %>" class="flex items-center gap-3 px-5 py-5">
    <img src="<%= negocioActual.logoUrl %>" alt="" class="h-9 w-9 flex-none rounded bg-white object-contain p-0.5" onerror="this.remove()">
    <span class="truncate font-titulo text-2xl font-semibold leading-none" title="<%= negocioActual.nombre %>"><%= negocioActual.nombre === config.negocio.nombre ? config.negocio.nombreCorto : negocioActual.nombre %></span>
  </a>

  <nav class="mt-2 flex-1 space-y-0.5 overflow-y-auto px-3 pb-6" aria-label="Menú principal">
    <% items.forEach(function (m) {
         const activo = m.ruta === '/' ? rutaActual === '/' : rutaActual.startsWith(m.ruta); %>
      <a href="<%= m.ruta %>"
         <% if (activo) { %>aria-current="page"<% } %>
         class="block rounded border-l-[3px] px-3 py-2 text-[15px] font-medium <%= activo ? 'border-acento bg-white/15 text-white' : 'border-transparent text-white/75 hover:bg-white/10 hover:text-white' %>">
        <%= m.nombre %>
      </a>
    <% }) %>
  </nav>

  <!-- Parte fija: la cuenta de la persona. El texto de "title" sirve de ayuda al pasar el cursor -->
  <div class="space-y-0.5 border-t border-white/15 px-3 py-3" aria-label="Mi cuenta">
    <a href="/cambiar-contrasena" title="Cambiar contraseña" class="flex items-center gap-3 rounded px-3 py-2 text-[15px] font-medium text-white/75 hover:bg-white/10 hover:text-white">
      <%- icono('key', 'h-5 w-5 flex-none') %><span class="truncate">Cambiar contraseña</span>
    </a>
    <form method="post" action="/logout">
      <button type="submit" title="Salir" class="flex w-full items-center gap-3 rounded px-3 py-2 text-left text-[15px] font-medium text-white/75 hover:bg-white/10 hover:text-white">
        <%- icono('logout', 'h-5 w-5 flex-none') %><span class="truncate">Salir</span>
      </button>
    </form>
  </div>
</aside>
