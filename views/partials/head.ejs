<%
  // Marca del negocio: la paleta que eligió (configuracion_negocio). Los tres colores ya vienen validados como #RRGGBB.
  const _n = typeof negocioActual !== 'undefined' && negocioActual ? negocioActual : null;
  const _marca = _n && _n.colores ? _n.colores : { primario: '#1E40AF', acento: '#F59E0B', acentoFuerte: '#CA8208' };
  const _nombreNegocio = _n && _n.nombre ? _n.nombre : config.negocio.nombre;
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titulo ? titulo + ' | ' : '' %><%= _nombreNegocio %></title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com"></script>
<script>
  // Colores del negocio disponibles como bg-primario, text-acento, bg-acentofuerte, etc.
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          primario: '<%= _marca.primario %>',
          acento: '<%= _marca.acento %>',
          acentofuerte: '<%= _marca.acentoFuerte %>',
          fondo: '#f4f5f7',
          tinta: '#1f2430',
          borde: '#dfe2e8',
        },
        fontFamily: {
          sans: ['Barlow', 'system-ui', 'sans-serif'],
          titulo: ['"Barlow Condensed"', 'Barlow', 'sans-serif'],
        },
      },
    },
  };
</script>
<style>:root { --primario: <%= _marca.primario %>; --acento: <%= _marca.acento %>; --acento-fuerte: <%= _marca.acentoFuerte %>; --color-primario: <%= _marca.primario %>; --color-acento: <%= _marca.acento %>; --tinta: #1f2430; --borde: #dfe2e8; --fondo: #f4f5f7; }</style>
<link rel="stylesheet" href="/css/app.css">
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<%- style %>
