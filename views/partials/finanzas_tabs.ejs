<%
  const pestanas = [
    { clave: 'resumen', ruta: '/finanzas', nombre: 'Resumen' },
    { clave: 'cxc', ruta: '/finanzas/cxc', nombre: 'Por cobrar' },
    { clave: 'cxp', ruta: '/finanzas/cxp', nombre: 'Por pagar' },
    { clave: 'movimientos', ruta: '/finanzas/movimientos', nombre: 'Movimientos' },
    { clave: 'partidas', ruta: '/finanzas/partidas', nombre: 'Libro diario' },
    { clave: 'reportes', ruta: '/finanzas/reportes', nombre: 'Reportes' },
  ];
%>
<nav aria-label="Secciones de finanzas" class="-mx-4 mb-4 overflow-x-auto border-b border-borde px-4 sm:-mx-6 sm:px-6">
  <ul class="flex min-w-max gap-1">
    <% pestanas.forEach(function (p) { const activa = p.clave === seccion; %>
      <li>
        <a href="<%= p.ruta %>" <% if (activa) { %>aria-current="page"<% } %>
           class="-mb-px block border-b-2 px-4 py-3 text-sm font-medium whitespace-nowrap <%= activa ? 'border-primario text-primario' : 'border-transparent text-gray-600 hover:border-borde hover:text-tinta' %>"><%= p.nombre %></a>
      </li>
    <% }) %>
  </ul>
</nav>
