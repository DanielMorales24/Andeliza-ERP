<script type="application/json" id="datos-pagina"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>
<%- include('../partials/finanzas_tabs', { seccion }) %>

<div x-data="cartera" @keydown.escape.window="cerrarTodo()">

  <!-- Resumen y antigüedad (cada tramo filtra la lista) -->
  <section aria-label="Antigüedad de saldos">
    <div class="flex flex-wrap items-baseline gap-x-8 gap-y-1">
      <p><span class="text-sm text-gray-600">Total pendiente </span><span class="font-titulo text-3xl font-semibold tabular-nums" :class="d.tipo === 'cxc' ? 'text-emerald-700' : 'text-red-700'" x-text="dinero(total)"></span></p>
      <p x-show="vencido > 0" x-cloak class="text-sm text-red-700"><span class="font-medium tabular-nums" x-text="dinero(vencido)"></span> vencido</p>
      <p class="text-sm text-gray-500"><span x-text="filas.length"></span> <span x-text="filas.length === 1 ? 'documento' : 'documentos'"></span></p>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-5" role="group" aria-label="Filtrar por antigüedad">
      <template x-for="t in porTramo" :key="t.clave">
        <button type="button" @click="tramo = (tramo === t.clave ? '' : t.clave)" :aria-pressed="tramo === t.clave"
                class="rounded-md border px-3 py-2 text-left transition" :class="tramo === t.clave ? 'border-primario bg-primario/5 ring-1 ring-primario' : 'border-borde bg-white hover:bg-fondo'">
          <span class="block text-xs font-medium" :class="t.color" x-text="t.etiqueta"></span>
          <span class="block text-sm font-semibold tabular-nums" x-text="dinero(t.monto)"></span>
          <span class="block text-xs text-gray-500" x-text="t.cantidad + (t.cantidad === 1 ? ' documento' : ' documentos')"></span>
        </button>
      </template>
    </div>
  </section>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <div class="relative min-w-[220px] flex-1 sm:max-w-md">
      <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" x-model="busqueda" :placeholder="'Buscar ' + d.textos.tercero.toLowerCase() + ' o documento'" aria-label="Buscar" class="campo h-11 pl-9" autocomplete="off">
    </div>
    <button type="button" class="btn-texto" x-show="tramo !== '' || busqueda !== ''" x-cloak @click="tramo = ''; busqueda = ''">Quitar filtros</button>
    <a :href="'/finanzas/reportes/antiguedad-saldos.pdf?tipo=' + d.tipo" target="_blank" rel="noopener" class="btn btn-secundario ml-auto h-11">Reporte PDF</a>
  </div>

  <!-- Vacío -->
  <div x-show="filas.length === 0" x-cloak class="mt-4 rounded-md border border-dashed border-borde bg-white px-6 py-14 text-center">
    <p class="font-titulo text-xl font-semibold" x-text="d.textos.vacio"></p>
  </div>
  <div x-show="filas.length > 0 && filtradas.length === 0" x-cloak class="mt-4 rounded-md border border-borde bg-white px-6 py-12 text-center"><p class="font-medium">Sin resultados con estos filtros</p></div>

  <!-- Tabla (escritorio) -->
  <div x-show="filtradas.length > 0" x-cloak class="mt-4 hidden overflow-x-auto rounded-md border border-borde bg-white md:block">
    <table class="min-w-full text-[13px]">
      <thead class="border-b border-borde bg-fondo text-left text-xs font-semibold text-gray-600">
        <tr>
          <th scope="col" class="px-3 py-2.5 font-semibold" x-text="d.textos.tercero"></th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Documento</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Fecha</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Vence</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Antigüedad</th>
          <th scope="col" class="px-3 py-2.5 text-right font-semibold">Monto</th>
          <th scope="col" class="px-3 py-2.5 text-right font-semibold">Saldo</th>
          <th scope="col" class="px-3 py-2.5"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-borde">
        <template x-for="f in filtradas" :key="f.origen + '-' + f.doc_id">
          <tr class="hover:bg-fondo/60">
            <td class="max-w-[14rem] truncate px-3 py-2 font-medium" x-text="f.tercero"></td>
            <td class="max-w-[16rem] truncate px-3 py-2 text-gray-600" :title="f.referencia" x-text="f.referencia"></td>
            <td class="whitespace-nowrap px-3 py-2 tabular-nums text-gray-600" x-text="fechaTexto(f.fecha_doc)"></td>
            <td class="whitespace-nowrap px-3 py-2 tabular-nums"><span x-text="fechaTexto(f.vence)"></span><span class="ml-1 text-xs text-gray-400" x-show="f.plazo_estimado" title="Plazo estimado: el documento no trae fecha de vencimiento">(est.)</span></td>
            <td class="px-3 py-2"><span class="insignia" :class="claseVenc(f)" x-text="etiquetaVenc(f)"></span></td>
            <td class="whitespace-nowrap px-3 py-2 text-right tabular-nums text-gray-500" x-text="dinero(f.monto)"></td>
            <td class="whitespace-nowrap px-3 py-2 text-right font-semibold tabular-nums" :class="d.tipo === 'cxc' ? 'text-emerald-700' : 'text-red-700'" x-text="dinero(f.saldo)"></td>
            <td class="whitespace-nowrap px-3 py-2 text-right">
              <button type="button" class="btn-texto" @click="abrirAbono(f)" x-text="d.textos.accion"></button>
              <button type="button" class="btn-texto apagar" @click="abrirHistorial(f)">Historial</button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <!-- Tarjetas (celular) -->
  <div x-show="filtradas.length > 0" x-cloak class="mt-4 space-y-3 md:hidden">
    <template x-for="f in filtradas" :key="f.origen + '-' + f.doc_id">
      <article class="rounded-md border border-borde bg-white p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0"><p class="truncate font-medium" x-text="f.tercero"></p><p class="truncate text-xs text-gray-500" x-text="f.referencia"></p></div>
          <p class="flex-none font-titulo text-xl font-semibold tabular-nums" :class="d.tipo === 'cxc' ? 'text-emerald-700' : 'text-red-700'" x-text="dinero(f.saldo)"></p>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 tabular-nums">
          <span class="insignia" :class="claseVenc(f)" x-text="etiquetaVenc(f)"></span>
          <span>Vence <span x-text="fechaTexto(f.vence)"></span><span x-show="f.plazo_estimado"> (est.)</span></span>
          <span x-show="f.saldo !== f.monto">de <span x-text="dinero(f.monto)"></span></span>
        </div>
        <div class="mt-3 flex gap-2 border-t border-borde pt-3">
          <button type="button" class="btn btn-primario h-11 flex-[2]" @click="abrirAbono(f)" x-text="d.textos.accion"></button>
          <button type="button" class="btn btn-secundario h-11 flex-1" @click="abrirHistorial(f)">Historial</button>
        </div>
      </article>
    </template>
  </div>

  <!-- Modal: abono / pago -->
  <div x-show="ab" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" id="modal-abono" :aria-label="d.textos.accion + ' deuda'">
    <div class="absolute inset-0 bg-tinta/50" @click="cerrarAbono()"></div>
    <form x-show="ab" @submit.prevent="guardarAbono()" novalidate class="relative flex max-h-[92vh] w-full max-w-md flex-col rounded-t-2xl bg-white shadow-xl sm:rounded-lg">
      <template x-if="ab">
        <div class="flex min-h-0 flex-1 flex-col">
          <header class="border-b border-borde px-5 py-4">
            <h2 class="font-titulo text-xl font-semibold" x-text="d.tipo === 'cxc' ? 'Registrar abono' : 'Registrar pago'"></h2>
            <p class="mt-0.5 truncate text-sm text-gray-600"><span class="font-medium text-tinta" x-text="ab.fila.tercero"></span> &middot; <span x-text="ab.fila.referencia"></span></p>
          </header>
          <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
            <div class="flex items-baseline justify-between rounded-md bg-fondo px-3 py-2.5">
              <span class="text-sm text-gray-600">Saldo pendiente</span><span class="font-titulo text-2xl font-semibold tabular-nums" x-text="dinero(ab.fila.saldo)"></span>
            </div>
            <div x-show="ab.error" x-cloak role="alert" class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="ab.error"></div>
            <div>
              <label class="etiqueta" for="ab-monto" x-text="d.tipo === 'cxc' ? 'Monto que paga el cliente' : 'Monto que pagas'"></label>
              <input id="ab-monto" class="campo h-12 text-lg tabular-nums" type="number" inputmode="decimal" min="0.01" step="0.01" x-model="ab.monto">
              <div class="mt-2 flex flex-wrap gap-2">
                <button type="button" class="h-10 rounded-md border border-borde px-3 text-sm hover:bg-fondo" @click="ab.monto = ab.fila.saldo">Saldo completo</button>
                <button type="button" class="h-10 rounded-md border border-borde px-3 text-sm hover:bg-fondo" @click="ab.monto = Math.round(ab.fila.saldo * 50) / 100">La mitad</button>
              </div>
              <p class="ayuda tabular-nums">Saldo después: <span class="font-medium" :class="nuevoSaldo < 0 ? 'text-red-700' : 'text-tinta'" x-text="dinero(nuevoSaldo)"></span><span x-show="nuevoSaldo === 0" class="font-medium text-emerald-700"> (queda saldado)</span></p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div><label class="etiqueta" for="ab-cuenta" x-text="d.tipo === 'cxc' ? 'Entra a' : 'Sale de'"></label>
                <select id="ab-cuenta" class="campo" x-model="ab.cuenta"><option value="caja">Caja general</option><option value="bancos">Bancos</option></select></div>
              <div><label class="etiqueta" for="ab-fecha">Fecha</label>
                <input id="ab-fecha" class="campo" type="date" :min="ab.fila.fecha_doc" :max="d.estado.hoy" x-model="ab.fecha"></div>
            </div>
            <div><label class="etiqueta" for="ab-notas">Notas <span class="font-normal text-gray-500">(opcional)</span></label>
              <input id="ab-notas" class="campo" maxlength="300" x-model="ab.notas" placeholder="Ej. transferencia, recibo 123"></div>
          </div>
          <footer class="flex justify-end gap-2 border-t border-borde bg-fondo/60 px-5 py-3" style="padding-bottom: calc(.75rem + env(safe-area-inset-bottom, 0px))">
            <button type="button" class="btn btn-secundario" @click="cerrarAbono()" :disabled="ab.guardando">Cancelar</button>
            <button type="submit" class="btn btn-primario" :disabled="ab.guardando" x-text="ab.guardando ? 'Guardando…' : (d.tipo === 'cxc' ? 'Registrar abono' : 'Registrar pago')"></button>
          </footer>
        </div>
      </template>
    </form>
  </div>

  <!-- Modal: historial -->
  <div x-show="hist" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" id="modal-historial" aria-label="Historial">
    <div class="absolute inset-0 bg-tinta/50" @click="hist = null"></div>
    <div x-show="hist" class="relative flex max-h-[92vh] w-full max-w-lg flex-col rounded-t-2xl bg-white shadow-xl sm:rounded-lg">
      <template x-if="hist">
        <div class="flex min-h-0 flex-1 flex-col">
          <header class="flex items-start justify-between gap-3 border-b border-borde px-5 py-4">
            <div class="min-w-0"><h2 class="font-titulo text-xl font-semibold">Historial</h2><p class="truncate text-sm text-gray-600"><span class="font-medium text-tinta" x-text="hist.fila.tercero"></span> &middot; <span x-text="hist.fila.referencia"></span></p></div>
            <button type="button" @click="hist = null" class="-mr-2 rounded p-2 text-gray-500 hover:bg-fondo" aria-label="Cerrar"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
          </header>
          <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
            <dl class="grid grid-cols-3 gap-2 text-center text-sm">
              <div class="rounded-md bg-fondo px-2 py-2"><dt class="text-xs text-gray-500">Monto</dt><dd class="font-medium tabular-nums" x-text="dinero(hist.fila.monto)"></dd></div>
              <div class="rounded-md bg-fondo px-2 py-2"><dt class="text-xs text-gray-500" x-text="d.tipo === 'cxc' ? 'Cobrado' : 'Pagado'"></dt><dd class="font-medium tabular-nums" :class="d.tipo === 'cxc' ? 'text-emerald-700' : 'text-red-700'" x-text="dinero(hist.fila.monto - hist.fila.saldo)"></dd></div>
              <div class="rounded-md bg-fondo px-2 py-2"><dt class="text-xs text-gray-500">Saldo</dt><dd class="font-medium tabular-nums" x-text="dinero(hist.fila.saldo)"></dd></div>
            </dl>
            <p class="mt-4 text-sm text-gray-500" x-show="hist.cargando">Cargando…</p>
            <p class="mt-4 text-sm text-red-700" x-show="hist.error" x-text="hist.error"></p>
            <p class="mt-4 text-sm text-gray-600" x-show="!hist.cargando && hist.movimientos.length === 0">Todavía no hay movimientos registrados.</p>
            <ul class="mt-3 divide-y divide-borde" x-show="hist.movimientos.length > 0">
              <template x-for="m in hist.movimientos" :key="m.id">
                <li class="flex items-start justify-between gap-3 py-3">
                  <div class="min-w-0" :class="m.anulado ? 'opacity-60' : ''">
                    <p class="text-sm font-medium tabular-nums" :class="[m.anulado ? 'line-through' : '', d.tipo === 'cxc' ? 'text-emerald-700' : 'text-red-700']" x-text="dinero(m.monto)"></p>
                    <p class="text-xs text-gray-500"><span x-text="fechaTexto(m.fecha)"></span> &middot; <span x-text="m.cuenta"></span><span x-show="m.usuario"> &middot; <span x-text="m.usuario"></span></span></p>
                    <p class="text-xs text-gray-500" x-show="m.notas" x-text="m.notas"></p>
                    <p class="text-xs text-red-700" x-show="m.anulado">Anulado<span x-show="m.motivo_anulacion" x-text="': ' + m.motivo_anulacion"></span></p>
                  </div>
                  <button type="button" class="btn-texto peligro flex-none" x-show="!m.anulado" @click="anulando = { mov: m, motivo: '', guardando: false, error: '' }">Anular</button>
                </li>
              </template>
            </ul>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Confirmar anulación -->
  <div x-show="anulando" x-cloak class="fixed inset-0 z-[55] flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" id="modal-anular" aria-label="Anular movimiento">
    <div class="absolute inset-0 bg-tinta/50" @click="anulando = null"></div>
    <form x-show="anulando" @submit.prevent="confirmarAnular()" class="relative w-full max-w-sm rounded-t-2xl bg-white p-5 shadow-xl sm:rounded-lg">
      <template x-if="anulando">
        <div>
          <h2 class="font-titulo text-xl font-semibold" x-text="'¿Anular ' + d.textos.movimiento + '?'"></h2>
          <p class="mt-2 text-sm text-gray-600">Se anula el <span x-text="d.textos.movimiento"></span> de <span class="font-medium text-tinta tabular-nums" x-text="dinero(anulando.mov.monto)"></span> y la deuda vuelve a quedar pendiente. En el libro diario queda la partida de anulación.</p>
          <div x-show="anulando.error" role="alert" class="mt-3 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="anulando.error"></div>
          <label class="etiqueta mt-3" for="an-motivo">Motivo <span class="font-normal text-gray-500">(opcional)</span></label>
          <input id="an-motivo" class="campo" maxlength="200" x-model="anulando.motivo" placeholder="Ej. error de digitación">
          <div class="mt-4 flex gap-2"><button type="button" class="btn btn-secundario flex-1" @click="anulando = null" :disabled="anulando.guardando">Cancelar</button><button type="submit" class="btn btn-primario flex-1" :disabled="anulando.guardando" x-text="anulando.guardando ? 'Anulando…' : 'Sí, anular'"></button></div>
        </div>
      </template>
    </form>
  </div>
</div>

<script src="/js/finanzas-cartera.js"></script>
