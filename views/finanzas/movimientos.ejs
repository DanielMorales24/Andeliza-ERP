<script type="application/json" id="datos-pagina"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>
<%- include('../partials/finanzas_tabs', { seccion }) %>

<div x-data="movimientos" @keydown.escape.window="cerrar()">

  <!-- Pestañas internas -->
  <div class="flex flex-wrap items-center gap-3">
    <div class="inline-flex rounded-md border border-borde bg-white p-0.5" role="tablist" aria-label="Tipo de movimiento">
      <template x-for="t in pestanas" :key="t.clave">
        <button type="button" role="tab" :aria-selected="tab === t.clave" @click="cambiarTab(t.clave)"
                class="rounded px-4 py-2 text-sm font-medium" :class="tab === t.clave ? 'bg-primario text-white' : 'text-gray-600 hover:bg-fondo'" x-text="t.etiqueta"></button>
      </template>
    </div>
    <button type="button" class="btn btn-primario ml-auto" @click="nuevo()" x-text="textoNuevo"></button>
  </div>

  <!-- Filtros -->
  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div class="relative min-w-[200px] flex-1 sm:max-w-sm">
      <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" x-model="f.q" placeholder="Buscar" aria-label="Buscar" class="campo h-11 pl-9" autocomplete="off">
    </div>
    <div><label class="etiqueta text-xs" for="mv-desde">Desde</label><input id="mv-desde" type="date" class="campo h-11 w-[9.5rem] py-1.5" x-model="f.desde"></div>
    <div><label class="etiqueta text-xs" for="mv-hasta">Hasta</label><input id="mv-hasta" type="date" class="campo h-11 w-[9.5rem] py-1.5" x-model="f.hasta"></div>
    <select x-model="f.estado" class="campo h-11 w-auto" aria-label="Condición de pago">
      <option value="">Todos</option>
      <option value="C" x-text="tab === 'ingresos' ? 'Cobrados' : 'Pagados'"></option>
      <option value="P" x-text="tab === 'ingresos' ? 'Por cobrar' : 'Por pagar'"></option>
      <option value="anulado" x-show="tab !== 'compras'">Anulados</option>
    </select>
  </div>
  <p class="mt-2 text-sm text-red-700" x-show="errorLista" x-cloak role="alert" x-text="errorLista"></p>

  <div class="mt-4 flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm" aria-live="polite">
    <p><span class="font-titulo text-2xl font-semibold tabular-nums" x-text="lista.resumen.cantidad"></span> <span class="text-gray-600" x-text="lista.resumen.cantidad === 1 ? 'registro' : 'registros'"></span></p>
    <p><span class="text-gray-600">Total: </span><span class="font-medium tabular-nums" :class="tab === 'ingresos' ? 'text-emerald-700' : 'text-red-700'" x-text="dinero(lista.resumen.suma)"></span></p>
    <p class="text-gray-500" x-show="cargando" x-cloak>Actualizando…</p>
  </div>

  <div x-show="lista.filas.length === 0 && !cargando" x-cloak class="mt-4 rounded-md border border-dashed border-borde bg-white px-6 py-14 text-center">
    <p class="font-titulo text-xl font-semibold">No hay registros con estos filtros</p>
    <button type="button" class="btn btn-primario mt-4" @click="nuevo()" x-text="textoNuevo"></button>
  </div>

  <!-- Tabla -->
  <div x-show="lista.filas.length > 0" x-cloak class="mt-4 hidden overflow-x-auto rounded-md border border-borde bg-white md:block">
    <table class="min-w-full text-[13px]">
      <thead class="border-b border-borde bg-fondo text-left text-xs font-semibold text-gray-600">
        <tr>
          <th scope="col" class="px-3 py-2.5 font-semibold">Fecha</th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Descripción</th>
          <th scope="col" class="px-3 py-2.5 font-semibold" x-text="tab === 'ingresos' ? 'Tipo' : (tab === 'gastos' ? 'Categoría' : 'Líneas')"></th>
          <th scope="col" class="px-3 py-2.5 font-semibold">Condición</th>
          <th scope="col" class="px-3 py-2.5 text-right font-semibold" x-text="tab === 'ingresos' ? 'Entra' : 'Sale'"></th>
          <th scope="col" class="px-3 py-2.5"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-borde">
        <template x-for="m in lista.filas" :key="tab + m.id">
          <tr class="hover:bg-fondo/60" :class="m.anulado ? 'opacity-60' : ''">
            <td class="whitespace-nowrap px-3 py-2 tabular-nums text-gray-600" x-text="fechaTexto(m.fecha)"></td>
            <td class="max-w-[22rem] px-3 py-2"><p class="truncate font-medium" :class="m.anulado ? 'line-through' : ''" x-text="m.descripcion"></p><p class="truncate text-xs text-gray-500" x-show="m.tercero" x-text="m.tercero"></p></td>
            <td class="px-3 py-2 capitalize text-gray-600" x-text="tab === 'compras' ? m.lineas : m.tipo"></td>
            <td class="px-3 py-2"><span class="insignia" :class="claseEstado(m)" x-text="textoEstado(m)"></span><span class="ml-1 text-xs text-gray-400" x-show="!m.contabilizado && !m.anulado" title="Registrado antes de iniciar la contabilidad">sin partida</span></td>
            <td class="whitespace-nowrap px-3 py-2 text-right font-semibold tabular-nums" :class="m.anulado ? 'text-gray-400 line-through' : (tab === 'ingresos' ? 'text-emerald-700' : 'text-red-700')" x-text="dinero(m.monto)"></td>
            <td class="whitespace-nowrap px-3 py-2 text-right"><button type="button" class="btn-texto peligro" x-show="tab !== 'compras' && !m.anulado" @click="anulando = { m: m, motivo: '', error: '', guardando: false }">Anular</button></td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <!-- Tarjetas (celular) -->
  <div x-show="lista.filas.length > 0" x-cloak class="mt-4 space-y-3 md:hidden">
    <template x-for="m in lista.filas" :key="tab + m.id">
      <article class="rounded-md border border-borde bg-white p-4" :class="m.anulado ? 'opacity-60' : ''">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0"><p class="truncate font-medium" :class="m.anulado ? 'line-through' : ''" x-text="m.descripcion"></p><p class="truncate text-xs text-gray-500"><span x-text="fechaTexto(m.fecha)"></span><span x-show="m.tercero"> &middot; <span x-text="m.tercero"></span></span></p></div>
          <p class="flex-none font-titulo text-xl font-semibold tabular-nums" :class="m.anulado ? 'text-gray-400 line-through' : (tab === 'ingresos' ? 'text-emerald-700' : 'text-red-700')" x-text="dinero(m.monto)"></p>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-2"><span class="insignia" :class="claseEstado(m)" x-text="textoEstado(m)"></span><span class="text-xs capitalize text-gray-500" x-show="tab !== 'compras'" x-text="m.tipo"></span></div>
        <div class="mt-3 border-t border-borde pt-3" x-show="tab !== 'compras' && !m.anulado"><button type="button" class="btn btn-secundario h-11 w-full" @click="anulando = { m: m, motivo: '', error: '', guardando: false }">Anular</button></div>
      </article>
    </template>
  </div>

  <div class="mt-4 text-center" x-show="lista.hayMas" x-cloak><button type="button" class="btn btn-secundario" :disabled="cargando" @click="cargar(false)">Cargar más</button></div>

  <!-- ===== Formulario: ingreso / gasto ===== -->
  <div x-show="modal === 'ingreso' || modal === 'gasto'" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" id="modal-movimiento" :aria-label="modal === 'ingreso' ? 'Nuevo ingreso' : 'Nuevo gasto'">
    <div class="absolute inset-0 bg-tinta/50" @click="cerrar()"></div>
    <form x-show="modal === 'ingreso' || modal === 'gasto'" @submit.prevent="guardarSimple()" novalidate class="relative flex max-h-[92vh] w-full max-w-lg flex-col rounded-t-2xl bg-white shadow-xl sm:rounded-lg">
      <header class="border-b border-borde px-5 py-4"><h2 class="font-titulo text-xl font-semibold" x-text="modal === 'ingreso' ? 'Nuevo ingreso' : 'Nuevo gasto'"></h2></header>
      <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
        <div x-show="error" x-cloak role="alert" class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="error"></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label class="etiqueta" for="m-tipo" x-text="modal === 'ingreso' ? 'Tipo de ingreso' : 'Categoría'"></label>
            <select id="m-tipo" class="campo" x-model="fs.tipo"><template x-for="t in (modal === 'ingreso' ? d.tiposIngreso : d.categoriasGasto)" :key="t[0]"><option :value="t[0]" x-text="t[1]"></option></template></select></div>
          <div><label class="etiqueta" for="m-monto">Monto</label><input id="m-monto" class="campo tabular-nums" type="number" inputmode="decimal" min="0.01" step="0.01" x-model="fs.monto"></div>
        </div>
        <div><label class="etiqueta" for="m-desc">Descripción <span class="text-red-600" aria-hidden="true">*</span></label><input id="m-desc" class="campo" maxlength="255" autocomplete="off" x-model="fs.descripcion" :placeholder="modal === 'ingreso' ? 'Ej. Alquiler de local' : 'Ej. Energía eléctrica'"></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label class="etiqueta" for="m-fecha">Fecha</label><input id="m-fecha" class="campo" type="date" :min="d.estado.inicio" :max="d.estado.hoy" x-model="fs.fecha" @change="ajustarVenc(fs)"></div>
          <div><label class="etiqueta" for="m-tercero" x-text="modal === 'ingreso' ? 'Cliente (opcional)' : 'Proveedor (opcional)'"></label>
            <select id="m-tercero" class="campo" x-model="fs.tercero"><option value="">Sin asignar</option><template x-for="t in (modal === 'ingreso' ? d.catalogos.clientes : d.catalogos.proveedores)" :key="t.id"><option :value="t.id" x-text="t.nombre"></option></template></select></div>
        </div>
        <fieldset>
          <legend class="etiqueta">Condición de pago</legend>
          <div class="grid grid-cols-2 gap-2" role="group">
            <button type="button" @click="fs.estado = 'C'" :aria-pressed="fs.estado === 'C'" class="h-11 rounded-md border text-sm font-medium" :class="fs.estado === 'C' ? 'border-primario bg-primario text-white' : 'border-borde bg-white hover:bg-fondo'" x-text="modal === 'ingreso' ? 'Cobrado' : 'Pagado'"></button>
            <button type="button" @click="fs.estado = 'P'; ajustarVenc(fs)" :aria-pressed="fs.estado === 'P'" class="h-11 rounded-md border text-sm font-medium" :class="fs.estado === 'P' ? 'border-primario bg-primario text-white' : 'border-borde bg-white hover:bg-fondo'" x-text="modal === 'ingreso' ? 'Por cobrar' : 'Por pagar'"></button>
          </div>
        </fieldset>
        <div x-show="fs.estado === 'C'"><label class="etiqueta" for="m-cuenta" x-text="modal === 'ingreso' ? 'El dinero entra a' : 'El dinero sale de'"></label>
          <select id="m-cuenta" class="campo" x-model="fs.cuenta"><option value="caja">Caja general</option><option value="bancos">Bancos</option></select></div>
        <div x-show="fs.estado === 'P'" x-cloak><label class="etiqueta" for="m-venc">Vence el <span class="font-normal text-gray-500">(opcional)</span></label>
          <input id="m-venc" class="campo" type="date" :min="fs.fecha" x-model="fs.vencimiento">
          <p class="ayuda" x-text="modal === 'ingreso' ? 'Queda en Cuentas por cobrar hasta que se cobre.' : 'Queda en Cuentas por pagar hasta que se pague.'"></p></div>
        <div><label class="etiqueta" for="m-notas">Notas <span class="font-normal text-gray-500">(opcional)</span></label><input id="m-notas" class="campo" maxlength="500" x-model="fs.notas"></div>
      </div>
      <footer class="flex justify-end gap-2 border-t border-borde bg-fondo/60 px-5 py-3" style="padding-bottom: calc(.75rem + env(safe-area-inset-bottom, 0px))">
        <button type="button" class="btn btn-secundario" @click="cerrar()" :disabled="guardando">Cancelar</button>
        <button type="submit" class="btn btn-primario" :disabled="guardando" x-text="guardando ? 'Guardando…' : 'Guardar'"></button>
      </footer>
    </form>
  </div>

  <!-- ===== Formulario: compra de inventario ===== -->
  <div x-show="modal === 'compra'" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" id="modal-compra" aria-label="Nueva compra de inventario">
    <div class="absolute inset-0 bg-tinta/50" @click="cerrar()"></div>
    <form x-show="modal === 'compra'" @submit.prevent="guardarCompra()" novalidate class="relative flex max-h-[94vh] w-full max-w-3xl flex-col rounded-t-2xl bg-white shadow-xl sm:rounded-lg">
      <header class="border-b border-borde px-5 py-4"><h2 class="font-titulo text-xl font-semibold">Nueva compra de inventario</h2><p class="mt-0.5 text-sm text-gray-600">Sube el stock y actualiza el costo de cada producto (promedio ponderado).</p></header>
      <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-5">
        <div x-show="error" x-cloak role="alert" class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="error"></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label class="etiqueta" for="c-prov">Proveedor</label><select id="c-prov" class="campo" x-model="fc.proveedor"><option value="">Sin proveedor</option><template x-for="p in d.catalogos.proveedores" :key="p.id"><option :value="p.id" x-text="p.nombre"></option></template></select></div>
          <div><label class="etiqueta" for="c-fecha">Fecha</label><input id="c-fecha" class="campo" type="date" :min="d.estado.inicio" :max="d.estado.hoy" x-model="fc.fecha" @change="ajustarVenc(fc)"></div>
        </div>

        <div>
          <label class="etiqueta" for="c-buscar">Agregar producto</label>
          <div class="relative" @click.outside="listaProd = false">
            <input id="c-buscar" class="campo" x-model="busquedaProd" @focus="listaProd = true" @input="listaProd = true" @keydown.escape.stop="listaProd = false" placeholder="Busca por nombre o SKU" autocomplete="off" role="combobox" :aria-expanded="listaProd && resultadosProd.length > 0">
            <ul x-show="listaProd && resultadosProd.length > 0" x-cloak role="listbox" class="absolute z-20 mt-1 max-h-64 w-full overflow-auto rounded-md border border-borde bg-white py-1 shadow-lg">
              <template x-for="p in resultadosProd" :key="p.id"><li role="option"><button type="button" @click="agregarProducto(p)" class="flex w-full items-center justify-between gap-3 px-3 py-2.5 text-left text-sm hover:bg-fondo"><span class="truncate" x-text="p.nombre"></span><span class="flex-none text-xs text-gray-500" x-text="(p.sku || 'Sin SKU') + ' · costo ' + dinero(p.precio_compra)"></span></button></li></template>
            </ul>
          </div>
        </div>

        <div class="overflow-x-auto rounded-md border border-borde" x-show="fc.items.length > 0">
          <table class="min-w-full text-[13px]">
            <thead class="border-b border-borde bg-fondo text-left text-xs font-semibold text-gray-600"><tr><th class="px-3 py-2 font-semibold">Producto</th><th class="px-3 py-2 font-semibold">Variante</th><th class="px-3 py-2 text-right font-semibold">Cantidad</th><th class="px-3 py-2 text-right font-semibold">Costo unit.</th><th class="px-3 py-2 text-right font-semibold">Subtotal</th><th class="px-3 py-2"><span class="sr-only">Quitar</span></th></tr></thead>
            <tbody class="divide-y divide-borde">
              <template x-for="(it, i) in fc.items" :key="it.uid">
                <tr>
                  <td class="px-3 py-1.5"><p class="font-medium" x-text="it.nombre"></p><p class="text-xs text-gray-500" x-text="it.sku || 'Sin SKU'"></p></td>
                  <td class="px-3 py-1.5"><select class="campo h-10 w-36 py-1" x-show="it.variantes.length > 0" x-model="it.variante_id" :aria-label="'Variante de ' + it.nombre"><option value="">Elegir…</option><template x-for="v in it.variantes" :key="v.id"><option :value="v.id" x-text="v.nombre"></option></template></select><span class="text-xs text-gray-400" x-show="it.variantes.length === 0">—</span></td>
                  <td class="px-3 py-1.5 text-right"><input class="campo h-10 w-24 py-1 text-right tabular-nums" type="number" inputmode="decimal" min="0.01" step="any" x-model="it.cantidad" :aria-label="'Cantidad de ' + it.nombre"></td>
                  <td class="px-3 py-1.5 text-right"><input class="campo h-10 w-28 py-1 text-right tabular-nums" type="number" inputmode="decimal" min="0" step="0.01" x-model="it.precio" :aria-label="'Costo de ' + it.nombre"></td>
                  <td class="whitespace-nowrap px-3 py-1.5 text-right font-medium tabular-nums" x-text="dinero(subtotalItem(it))"></td>
                  <td class="px-3 py-1.5 text-right"><button type="button" class="btn-texto peligro" @click="fc.items.splice(i, 1)" :aria-label="'Quitar ' + it.nombre">Quitar</button></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-gray-500" x-show="fc.items.length === 0">Busca un producto arriba para empezar. Los kits no se compran: se compran sus componentes.</p>

        <div class="flex items-baseline justify-between rounded-md bg-fondo px-4 py-3"><span class="text-sm font-medium">Total de la compra</span><span class="font-titulo text-2xl font-semibold tabular-nums text-red-700" x-text="dinero(totalCompra)"></span></div>

        <fieldset>
          <legend class="etiqueta">Condición de pago</legend>
          <div class="grid grid-cols-2 gap-2" role="group">
            <button type="button" @click="fc.estado = 'C'" :aria-pressed="fc.estado === 'C'" class="h-11 rounded-md border text-sm font-medium" :class="fc.estado === 'C' ? 'border-primario bg-primario text-white' : 'border-borde bg-white hover:bg-fondo'">Pagada</button>
            <button type="button" @click="fc.estado = 'P'; ajustarVenc(fc)" :aria-pressed="fc.estado === 'P'" class="h-11 rounded-md border text-sm font-medium" :class="fc.estado === 'P' ? 'border-primario bg-primario text-white' : 'border-borde bg-white hover:bg-fondo'">Por pagar</button>
          </div>
        </fieldset>
        <div x-show="fc.estado === 'C'"><label class="etiqueta" for="c-cuenta">El dinero sale de</label><select id="c-cuenta" class="campo sm:w-64" x-model="fc.cuenta"><option value="caja">Caja general</option><option value="bancos">Bancos</option></select></div>
        <div x-show="fc.estado === 'P'" x-cloak><label class="etiqueta" for="c-venc">Vence el <span class="font-normal text-gray-500">(opcional)</span></label><input id="c-venc" class="campo sm:w-64" type="date" :min="fc.fecha" x-model="fc.vencimiento"><p class="ayuda">Queda en Cuentas por pagar hasta que se pague.</p></div>
        <div><label class="etiqueta" for="c-notas">Notas <span class="font-normal text-gray-500">(opcional)</span></label><input id="c-notas" class="campo" maxlength="500" x-model="fc.notas" placeholder="Ej. factura del proveedor 0045"></div>
      </div>
      <footer class="flex justify-end gap-2 border-t border-borde bg-fondo/60 px-5 py-3" style="padding-bottom: calc(.75rem + env(safe-area-inset-bottom, 0px))">
        <button type="button" class="btn btn-secundario" @click="cerrar()" :disabled="guardando">Cancelar</button>
        <button type="submit" class="btn btn-primario" :disabled="guardando || fc.items.length === 0" x-text="guardando ? 'Guardando…' : 'Registrar compra'"></button>
      </footer>
    </form>
  </div>

  <!-- ===== Anular ===== -->
  <div x-show="anulando" x-cloak class="fixed inset-0 z-[55] flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" id="modal-anular-mov" aria-label="Anular registro">
    <div class="absolute inset-0 bg-tinta/50" @click="anulando = null"></div>
    <form x-show="anulando" @submit.prevent="confirmarAnular()" class="relative w-full max-w-sm rounded-t-2xl bg-white p-5 shadow-xl sm:rounded-lg">
      <template x-if="anulando"><div>
        <h2 class="font-titulo text-xl font-semibold" x-text="tab === 'ingresos' ? '¿Anular este ingreso?' : '¿Anular este gasto?'"></h2>
        <p class="mt-2 text-sm text-gray-600"><span class="font-medium text-tinta" x-text="anulando.m.descripcion"></span> por <span class="font-medium text-tinta tabular-nums" x-text="dinero(anulando.m.monto)"></span>. Se contrarresta su partida y deja de contar. No se puede anular si ya tiene cobros o pagos: anúlalos primero.</p>
        <div x-show="anulando.error" role="alert" class="mt-3 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="anulando.error"></div>
        <label class="etiqueta mt-3" for="am-motivo">Motivo <span class="font-normal text-gray-500">(opcional)</span></label><input id="am-motivo" class="campo" maxlength="200" x-model="anulando.motivo">
        <div class="mt-4 flex gap-2"><button type="button" class="btn btn-secundario flex-1" @click="anulando = null" :disabled="anulando.guardando">Cancelar</button><button type="submit" class="btn btn-primario flex-1" :disabled="anulando.guardando" x-text="anulando.guardando ? 'Anulando…' : 'Sí, anular'"></button></div>
      </div></template>
    </form>
  </div>
</div>

<script src="/js/finanzas-movimientos.js"></script>
