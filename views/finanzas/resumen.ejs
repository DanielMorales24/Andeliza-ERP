<script type="application/json" id="datos-pagina"><%- JSON.stringify(datos).replace(/</g, '\\u003c') %></script>
<%- include('../partials/finanzas_tabs', { seccion }) %>

<div x-data="finanzasResumen" @keydown.escape.window="cerrar()">

  <!-- Contabilidad sin iniciar -->
  <div x-show="!d.estado.iniciada" x-cloak class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3">
    <p class="font-medium text-amber-900">La contabilidad todavía no ha empezado</p>
    <p class="mt-1 text-sm text-amber-800">Al iniciarla se toma el estado de hoy como punto de partida (inventario y ventas pendientes) y desde ese día cada venta, compra, gasto y pago genera su partida contable.</p>
    <button type="button" class="btn btn-primario mt-3" :disabled="trabajando" @click="iniciar()" x-text="trabajando ? 'Iniciando…' : 'Iniciar contabilidad hoy'"></button>
  </div>

  <!-- Tarjetas -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Indicadores">
    <article class="rounded-md border border-borde border-l-4 border-l-primario bg-white p-4">
      <p class="text-sm text-gray-600">Dinero en caja y bancos</p>
      <p class="mt-1 font-titulo text-3xl font-semibold tabular-nums" :class="d.caja.total < 0 ? 'text-red-700' : ''" x-text="dinero(d.caja.total)"></p>
      <p class="mt-1 text-xs text-gray-500 tabular-nums">Caja <span x-text="dinero(d.caja.caja)"></span> &nbsp; Bancos <span x-text="dinero(d.caja.bancos)"></span></p>
    </article>

    <a href="/finanzas/cxc" class="block rounded-md border border-borde border-l-4 border-l-emerald-600 bg-white p-4 transition hover:border-emerald-300">
      <p class="text-sm text-gray-600">Por cobrar (clientes)</p>
      <p class="mt-1 font-titulo text-3xl font-semibold tabular-nums text-emerald-700" x-text="dinero(d.cxc.total)"></p>
      <p class="mt-1 text-xs tabular-nums" :class="d.cxc.vencido > 0 ? 'text-red-700' : 'text-gray-500'">
        <span x-show="d.cxc.vencido > 0">Vencido <span x-text="dinero(d.cxc.vencido)"></span></span>
        <span x-show="d.cxc.vencido <= 0"><span x-text="d.cxc.documentos"></span> <span x-text="d.cxc.documentos === 1 ? 'documento' : 'documentos'"></span>, nada vencido</span>
      </p>
    </a>

    <a href="/finanzas/cxp" class="block rounded-md border border-borde border-l-4 border-l-red-600 bg-white p-4 transition hover:border-red-300">
      <p class="text-sm text-gray-600">Por pagar (proveedores)</p>
      <p class="mt-1 font-titulo text-3xl font-semibold tabular-nums text-red-700" x-text="dinero(d.cxp.total)"></p>
      <p class="mt-1 text-xs tabular-nums" :class="d.cxp.vencido > 0 ? 'text-red-700' : 'text-gray-500'">
        <span x-show="d.cxp.vencido > 0">Vencido <span x-text="dinero(d.cxp.vencido)"></span></span>
        <span x-show="d.cxp.vencido <= 0"><span x-text="d.cxp.documentos"></span> <span x-text="d.cxp.documentos === 1 ? 'documento' : 'documentos'"></span>, nada vencido</span>
      </p>
    </a>

    <article class="rounded-md border border-borde border-l-4 bg-white p-4" :class="d.utilidadMes.utilidad >= 0 ? 'border-l-emerald-600' : 'border-l-red-600'">
      <p class="text-sm text-gray-600">Utilidad neta del mes</p>
      <p class="mt-1 font-titulo text-3xl font-semibold tabular-nums" :class="colorMonto(d.utilidadMes.utilidad)" x-text="dinero(d.utilidadMes.utilidad)"></p>
      <p class="mt-1 text-xs text-gray-500 tabular-nums">
        <span x-text="comparacion.texto" :class="comparacion.clase"></span>
      </p>
    </article>
  </section>

  <!-- Avisos -->
  <div class="mt-4 space-y-2" aria-live="polite">
    <p x-show="d.cxc.vencidos > 0" x-cloak class="rounded-md border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-800">
      <span class="font-medium" x-text="d.cxc.vencidos + (d.cxc.vencidos === 1 ? ' cuenta por cobrar vencida' : ' cuentas por cobrar vencidas')"></span>
      por <span class="tabular-nums" x-text="dinero(d.cxc.vencido)"></span>. <a href="/finanzas/cxc" class="font-medium underline">Ver deudores</a>
    </p>
    <p x-show="d.cxp.vencidos > 0" x-cloak class="rounded-md border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-800">
      <span class="font-medium" x-text="d.cxp.vencidos + (d.cxp.vencidos === 1 ? ' deuda con proveedores vencida' : ' deudas con proveedores vencidas')"></span>
      por <span class="tabular-nums" x-text="dinero(d.cxp.vencido)"></span>. <a href="/finanzas/cxp" class="font-medium underline">Ver lo que debemos</a>
    </p>
    <div x-show="d.estado.iniciada && Math.abs(d.inventario.diferencia) >= 1" x-cloak class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900">
      <p>Las existencias valen <span class="font-medium tabular-nums" x-text="dinero(d.inventario.existencias)"></span> y el libro registra <span class="font-medium tabular-nums" x-text="dinero(d.inventario.libro)"></span>.</p>
      <button type="button" class="btn btn-secundario h-10" @click="abrirConciliar()">Conciliar inventario</button>
    </div>
  </div>

  <!-- Gráfico -->
  <section class="mt-6 rounded-md border border-borde bg-white p-4" aria-label="Flujo de caja y utilidad">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="font-titulo text-lg font-semibold">Flujo de caja y utilidad</h2>
        <p class="text-sm text-gray-600">Últimos 6 meses. El flujo es el dinero que entró y salió; la utilidad es lo que ganó el negocio.</p>
      </div>
      <div class="flex gap-2">
        <a href="/finanzas/movimientos?nuevo=ingreso" class="btn btn-secundario h-10">Nuevo ingreso</a>
        <a href="/finanzas/movimientos?nuevo=gasto" class="btn btn-secundario h-10">Nuevo gasto</a>
        <a href="/finanzas/movimientos?nuevo=compra" class="btn btn-secundario h-10" x-show="d.compras !== false">Nueva compra</a>
        <button type="button" class="btn btn-secundario h-10" @click="abrirSaldo()">Saldo inicial</button>
      </div>
    </div>
    <div class="relative mt-4 h-64 sm:h-72"><canvas id="grafico-meses" role="img" aria-label="Gráfico de barras del flujo de caja y la utilidad de los últimos 6 meses"></canvas></div>

    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-[13px]">
        <thead class="border-b border-borde text-left text-xs font-semibold text-gray-600">
          <tr><th scope="col" class="py-2 pr-4 font-semibold">Mes</th><th scope="col" class="px-4 py-2 text-right font-semibold">Flujo de caja</th><th scope="col" class="py-2 pl-4 text-right font-semibold">Utilidad</th></tr>
        </thead>
        <tbody class="divide-y divide-borde">
          <template x-for="m in d.meses" :key="m.mes">
            <tr>
              <td class="py-1.5 pr-4 capitalize" x-text="nombreMes(m.mes)"></td>
              <td class="px-4 py-1.5 text-right tabular-nums" :class="colorMonto(m.flujo)" x-text="dinero(m.flujo)"></td>
              <td class="py-1.5 pl-4 text-right tabular-nums" :class="colorMonto(m.utilidad)" x-text="dinero(m.utilidad)"></td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Saldo inicial -->
  <div x-show="modal === 'saldo'" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-label="Saldo inicial">
    <div class="absolute inset-0 bg-tinta/50" @click="cerrar()"></div>
    <form @submit.prevent="guardarSaldo()" novalidate class="relative w-full max-w-md rounded-t-2xl bg-white shadow-xl sm:rounded-lg">
      <header class="border-b border-borde px-5 py-4"><h2 class="font-titulo text-xl font-semibold">Saldo inicial de caja o bancos</h2></header>
      <div class="space-y-4 px-5 py-5">
        <p class="text-sm text-gray-600">Registra con cuánto dinero arrancó el negocio en Caja o en el banco. Queda como aporte al capital.</p>
        <div x-show="error" x-cloak role="alert" class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="error"></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label class="etiqueta" for="si-cuenta">Cuenta</label>
            <select id="si-cuenta" class="campo" x-model="saldo.cuenta"><option value="caja">Caja general</option><option value="bancos">Bancos</option></select></div>
          <div><label class="etiqueta" for="si-monto">Monto</label>
            <input id="si-monto" class="campo" type="number" inputmode="decimal" min="0.01" step="0.01" x-model="saldo.monto"></div>
        </div>
        <div><label class="etiqueta" for="si-fecha">Fecha</label>
          <input id="si-fecha" class="campo" type="date" :min="d.estado.inicio" :max="d.estado.hoy" x-model="saldo.fecha"></div>
      </div>
      <footer class="flex justify-end gap-2 border-t border-borde bg-fondo/60 px-5 py-3">
        <button type="button" class="btn btn-secundario" @click="cerrar()" :disabled="trabajando">Cancelar</button>
        <button type="submit" class="btn btn-primario" :disabled="trabajando" x-text="trabajando ? 'Guardando…' : 'Registrar'"></button>
      </footer>
    </form>
  </div>

  <!-- Conciliar inventario -->
  <div x-show="modal === 'conciliar'" x-cloak class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-label="Conciliar inventario">
    <div class="absolute inset-0 bg-tinta/50" @click="cerrar()"></div>
    <form @submit.prevent="conciliar()" novalidate class="relative w-full max-w-md rounded-t-2xl bg-white shadow-xl sm:rounded-lg">
      <header class="border-b border-borde px-5 py-4"><h2 class="font-titulo text-xl font-semibold">Conciliar inventario</h2></header>
      <div class="space-y-4 px-5 py-5">
        <p class="text-sm text-gray-600">Existencias: <span class="font-medium text-tinta tabular-nums" x-text="dinero(d.inventario.existencias)"></span>. Libro: <span class="font-medium text-tinta tabular-nums" x-text="dinero(d.inventario.libro)"></span>.
          Diferencia: <span class="font-medium tabular-nums" :class="colorMonto(d.inventario.diferencia)" x-text="dinero(d.inventario.diferencia)"></span>.</p>
        <div x-show="error" x-cloak role="alert" class="rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" x-text="error"></div>
        <fieldset class="space-y-2">
          <legend class="etiqueta">¿Qué representa esa diferencia?</legend>
          <label class="flex cursor-pointer items-start gap-3 rounded-md border border-borde p-3"><input type="radio" class="mt-1" value="capital" x-model="contra"><span class="text-sm"><span class="font-medium">Mercadería inicial</span><span class="block text-xs text-gray-500">Productos que ya tenía el negocio o que cargué al sistema. Aumenta el capital y no cuenta como ganancia.</span></span></label>
          <label class="flex cursor-pointer items-start gap-3 rounded-md border border-borde p-3"><input type="radio" class="mt-1" value="ajuste" x-model="contra"><span class="text-sm"><span class="font-medium">Ajuste de inventario</span><span class="block text-xs text-gray-500">Mermas, pérdidas o sobrantes. Pasa por el estado de resultados.</span></span></label>
        </fieldset>
      </div>
      <footer class="flex justify-end gap-2 border-t border-borde bg-fondo/60 px-5 py-3">
        <button type="button" class="btn btn-secundario" @click="cerrar()" :disabled="trabajando">Cancelar</button>
        <button type="submit" class="btn btn-primario" :disabled="trabajando" x-text="trabajando ? 'Conciliando…' : 'Conciliar'"></button>
      </footer>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="/js/finanzas-resumen.js"></script>
