# Variables de las pruebas automatizadas (npm test, npm run test:e2e).
# Copia este archivo como .env.test y ajusta la contraseña de tu PostgreSQL local si es otra.
#
# REGLAS (las comprueba tests/soporte/guardas.js antes de tocar nada):
#   - La base es LOCAL (localhost) y su nombre termina en _test. Nunca Supabase ni producción.
#   - Las pruebas BORRAN y vuelven a crear esa base en cada corrida.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andeliza_test
SESSION_SECRET=solo-para-pruebas-locales
# Puerto del servidor que levanta Playwright para la prueba E2E
PUERTO_E2E=3100
# Sin Storage: ninguna prueba sube imágenes
SUPABASE_URL=
SUPABASE_KEY=
