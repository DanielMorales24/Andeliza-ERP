{
  "name": "sistema-erp-base",
  "version": "0.1.0",
  "description": "Sistema de gestión web para pymes (template base): Node + Express + EJS + Supabase",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch app.js",
    "start": "node app.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integracion",
    "test:e2e": "playwright test",
    "test:db": "node tests/soporte/preparar-base.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jest": "30.5.2",
    "supertest": "7.3.2"
  }
}
